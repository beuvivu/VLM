# Copy to .env and adjust (install.sh / install.ps1 do this once). Every setting in
# src/vietlott_engine/core/config.py can be overridden with VQE_<NAME>.

# project folder: the `vietlott` command moves here before running (default: found automatically)
# VQE_HOME=/path/to/vietlott-quant-engine

# storage
VQE_DATA_DIR=data
VQE_STORAGE_BACKEND=duckdb            # duckdb | memory
VQE_SEED_FILE_DIR=data/seed           # bundled JSONL snapshot loaded when the store is empty
VQE_CALIBRATION_DIR=data/calibration  # behaviour_*.json / market_*.json written by `vietlott market`
VQE_ANCHORS_FILE=data/seed/jackpot_anchors.json
VQE_PRODUCT_SEED_DIR=data/seed         # bundled Keno / Bingo18 / Max 3D histories (merged with $VQE_DATA_DIR/products)
# self-learning forecaster state + ledger of the forecasts recorded on THIS computer. Kept apart from
# data/forecast/ledger.jsonl, the public ledger that GitHub Actions commits to the repo, so running the
# engine locally never changes a tracked file (no conflict on git pull / GitHub Desktop "Pull origin").
VQE_FORECAST_DIR=data/local/forecast
# VQE_FORECAST_NOW=2026-09-30T20:00:00+07:00   # fix "now" for the ledger's draw-schedule check (tests, replays)

# crawler
VQE_SOURCE=auto                       # vietlott → nhanaz → github_mirror; or file
# vietlott.vn answers Vietnamese IP addresses only. From abroad, route the crawler through a
# proxy you operate in Vietnam with the standard variable (httpx honours it):
# HTTPS_PROXY=http://user:pass@your-vn-host:3128
VQE_VIETLOTT_BASE_URL=https://www.vietlott.vn
VQE_VIETLOTT_COOKIE_BOOTSTRAP=true     # read the cookie the site sets via document.cookie before AjaxPro calls
VQE_CANONICAL_BASE_URL=https://raw.githubusercontent.com/pqminh-4/vietlott-data/main/data/canonical
VQE_PRODUCT_MIRROR_BASE_URL=https://raw.githubusercontent.com/vietvudanh/vietlott-data/main/data
VQE_PRODUCT_SYNC_MAX_PAGES=50
# fallback when vietlott.vn is unreachable (README §1.7): sources tried in this order by --source auto
VQE_FALLBACK_ORDER=["vietlott","nhanaz","github_mirror","v130"]
VQE_NHANAZ_BASE_URL=https://raw.githubusercontent.com/NhanAZ-Data/vietlott-research/main/datasets
# VQE_NHANAZ_DIR=/path/to/vietlott-research          # local clone/ZIP of the community archive (no network needed)
# VQE_V130_DIR=/path/to/Vietlott-Quant-Engine-1.3.0  # 1.3.0 package: its data/products snapshot becomes a source
# VQE_DUCKDB_CLI=/usr/local/bin/duckdb               # Parquet reader if neither duckdb nor pyarrow is importable
VQE_PRIZE_WINNERS_BASE_URL=https://raw.githubusercontent.com/Compal123/vietlot-ai/main/data
VQE_PRIZE_POWER_HISTORY_URL=https://raw.githubusercontent.com/leoodz/vn-vietlott/main/results/power6x55.json
VQE_SYNC_ON_STARTUP=false
VQE_AUTO_UPDATE_ENABLED=true         # API tự đồng bộ theo lịch từng sản phẩm, giờ Việt Nam
VQE_ML_AUTO_UPDATE_ENABLED=true      # học sau khi đã lưu kết quả; lỗi model hiện trong updates/status
VQE_ML_BOOTSTRAP=1000                # cold start giới hạn CPU; live evidence bắt đầu sau bootstrap
VQE_ML_LEARNING_TIMEOUT_S=180        # budget model riêng; giữ trạng thái thành công của kết quả đã lưu
VQE_ML_TREE_EVERY=64                 # cây fit lại trên buffer; SGD/GRU/policy cập nhật từng kỳ
VQE_ML_BACKENDS=["rf"]               # thêm xgb,lgb sau pip install -e ".[ml]"
VQE_ML_SEARCH_NODES=1000             # budget tìm Top N; hết budget thì ranking_exact=false
VQE_AUTO_UPDATE_TIMEOUT_S=180         # budget cho một sản phẩm; lỗi không chặn sản phẩm khác
VQE_SOURCE_TIMEOUT_S=20               # budget từng nguồn, còn thời gian chuyển fallback
# VQE_AUTO_UPDATE_DIR=data/updates    # checkpoint + journal; mặc định trong VQE_DATA_DIR
# VQE_HTTP_BACKEND=curl_cffi          # cần pip install -e ".[crawler]"; Docker đã cài
VQE_HTTP_TIMEOUT_S=20
VQE_MAX_RETRIES=5
VQE_BACKOFF_BASE_S=0.5
VQE_BACKOFF_MAX_S=30
VQE_RATE_LIMIT_PER_S=2
VQE_MAX_CONCURRENCY=4

# game-theory priors (calibrate when you have winner-count data)
VQE_QUICK_PICK_SHARE=0.35
VQE_DEFAULT_TICKETS_SOLD=1500000

# logging
VQE_LOG_LEVEL=INFO
VQE_LOG_JSON=false
